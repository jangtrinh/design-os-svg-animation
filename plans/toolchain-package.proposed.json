{
  "name": "design-os-svg-animation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "check:scaffold": "node scripts/check-scaffold.mjs",
    "research:queue": "node scripts/research-queue.mjs",
    "validate:ir": "node scripts/validate-ir.mjs",
    "test:ir": "node --test tests/motion-ir.test.mjs",
    "typecheck:ir": "tsc --noEmit --strict --skipLibCheck --target ES2022 src/ir/motion-ir.ts",
    "check:ir": "npm run check:scaffold && npm run typecheck:ir && npm run validate:ir -- fixtures/opacity.motion.json && npm run test:ir",
    "optimize:svg": "node scripts/optimize-svg.mjs",
    "dev:toolchain": "vite playground --host 127.0.0.1",
    "build:toolchain": "vite build playground",
    "preview:toolchain": "vite preview playground --host 127.0.0.1"
  },
  "dependencies": {
    "flubber": "0.4.2",
    "gsap": "3.13.0",
    "lottie-web": "5.13.0",
    "opentype.js": "1.3.4",
    "paper": "0.12.18",
    "polymorph-js": "1.0.2"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "typescript": "5.8.3",
    "vite": "6.1.0",
    "svgo": "4.0.0"
  }
}
